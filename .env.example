# Hugging Face token (https://huggingface.co/settings/tokens)
# Required. Never commit the real .env file.
HF_TOKEN=

# OpenAI-compatible HF router
HF_BASE_URL=https://router.huggingface.co/v1

# Model on the HF router (provider suffix after :)
REVIEW_MODEL=MiniMaxAI/MiniMax-M3:novita

# Local review server (extension talks to this)
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8765

# Max completion tokens (keep costs low)
REVIEW_MAX_TOKENS=400
